# Personal mise configuration (keep shared mise.toml and mise.lock tracked)
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise.*.local.toml

# Project-local mise runtime data (keep .mise/tasks/ tracked)
/.mise/cache/
/.mise/downloads/
/.mise/installs/
/.mise/tmp/

# Build, download, and test artifacts
/build/
/dist/
/downloads/
/tmp/
/temp/
/test/output/
/test/tmp/
*.tmp
*.temp
*.log

# Local environment secrets (keep example files tracked)
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating-system artifacts
/.idea/
/.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
